# Resolve the workspace root for whichever of the three shells we are in.
#
# The same directory has a different absolute path in each, and getting it wrong
# is the classic failure here:
#
#   HOST          /opencloud                        (a real directory)
#   PLATFORM SDK  /opencloud -> /parentroot/opencloud   (a SYMLINK)
#   HABUILD SDK   /parentroot/parentroot/opencloud  (no /opencloud at all)
#
# In the PLATFORM SDK the symlink is fine for ordinary shell commands, but
# scratchbox2 does NOT resolve it: inside `sb2 -t lenovo-karatep-aarch64`,
# /opencloud/... is "No such file or directory" while /parentroot/opencloud/...
# works. Since mb2 runs rpmbuild under sb2, ANDROID_ROOT must be the real path
# there or every package build dies with
#     error: Unable to open $ANDROID_ROOT/.mb2/spec: No such file or directory
# The droid-config kickstart already uses the /parentroot form for the local repo,
# which is the same reasoning.
if [ -d /parentroot/parentroot/opencloud ]; then
    _HADK_ROOT=/parentroot/parentroot/opencloud     # HABUILD SDK
elif [ -L /opencloud ] && [ -d /parentroot/opencloud ]; then
    _HADK_ROOT=/parentroot/opencloud                # PLATFORM SDK (sb2-safe)
else
    _HADK_ROOT=/opencloud                           # HOST
fi

export ANDROID_ROOT="$_HADK_ROOT/hadk"
export VENDOR="lenovo"
export DEVICE="karatep"
export PORT_ARCH="aarch64"
export GIT_CONFIG_GLOBAL="$_HADK_ROOT/.gitconfig"
unset _HADK_ROOT

# Sailfish OS release to build the image against. build_packages.sh -i refuses to
# run without it ("Please set the desired RELEASE variable in ~/.hadk.env") and the
# image lands in $ANDROID_ROOT/sfe-$DEVICE-$RELEASE$EXTRA_NAME.
export RELEASE="5.1.0.11"
# Optional suffix for the output directory, e.g. EXTRA_NAME="-test1".
#export EXTRA_NAME=""

# HADK's $HOME/.hadk.env template offers this so a bare `mb2 build` drops its RPMs
# straight into the local repo instead of .mb2/. build_packages.sh passes its own
# --output-dir, so this only affects mb2 invoked by hand.
alias mb2='mb2 --output-dir "${ANDROID_ROOT?}/droid-local-repo/${DEVICE?}"'
