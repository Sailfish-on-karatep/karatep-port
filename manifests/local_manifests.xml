<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<project path="device/lenovo/karatep"
		name="Sailfish-on-karatep/android_device_lenovo_karatep"
		revision="hybris-18.1" />
	<project path="device/lenovo/karate-common"
		name="Sailfish-on-karatep/android_device_lenovo_karate-common"
		revision="hybris-18.1" />
	<project path="kernel/lenovo/msm8937"
		name="Sailfish-on-karatep/android_kernel_lenovo_msm8937"
		revision="hybris-18.1" />
	<project path="vendor/lenovo"
		name="Sailfish-on-karatep/proprietary_vendor_lenovo"
		revision="lineage-18.1" />
	<project path="packages/resources/devicesettings"
		name="LineageOS/android_packages_resources_devicesettings"
		revision="lineage-18.1" />
	<project path="rpm/"
 		name="Sailfish-on-karatep/droid-hal-karatep" revision="hybris-18.1" />
	<project path="hybris/droid-configs"
		name="Sailfish-on-karatep/droid-config-karatep" revision="hybris-18.1" />
	<project path="hybris/droid-hal-version-karatep"
		name="Sailfish-on-karatep/droid-hal-version-karatep" revision="hybris-18.1" />

	<!--
	  hybris-patches: use the karatep fork instead of mer-hybris/hybris-patches.

	  The fork is a strict superset - it carries the full upstream hybris-18.1
	  patch series plus the karatep-specific patches, numbered so that the
	  lexicographic order apply-patches.sh relies on (it runs
	  `git am <dir>/*.patch`) matches the dependency order:

	      bionic/0001..0008              upstream
	      bionic/0009                    karatep: TLS_SLOT_ART_THREAD_SELF
	      system/core/0001..0039         upstream
	      system/core/0040               linkerconfig switch for no updatable apex
	      system/core/0041               always regenerate linker config (needs 0040)
	      system/core/0042               finalise linker config before `on init` (needs 0041)
	      hybris/hybris-boot/0001        karatep mountpoint fixups

	  Without this override a fresh `repo sync` pulls upstream hybris-patches,
	  apply-patches.sh silently produces a tree with none of the karatep fixes,
	  and the device boots without a working /dev/vndbinder (see
	  hybris_lenovo_karatep_devjournal/vndservicemanager_libbinder_rca.md).

	  remove-project is required first: repo refuses two projects on the same path.
	-->
	<remove-project name="mer-hybris/hybris-patches" />
	<project path="hybris-patches"
		name="Sailfish-on-karatep/hybris-patches" revision="hybris-18.1" />

	<!--
	  Drop the Chromium WebView patches project.

	  LineageOS' manifest (snippets/lineage.xml) declares

	      <linkfile src="Android.mk" dest="external/chromium-webview/Android.mk" />

	  but the patches repo no longer ships Android.mk - it was renamed to
	  os_pickup.mk upstream. repo therefore creates a DANGLING symlink at
	  external/chromium-webview/Android.mk, which ckati then tries to read:

	      build/make/core/prebuilt.mk:53: error:
	          external/chromium-webview/Android.mk: No such file or directory

	  and the whole hybris-hal build dies. Sailfish OS never builds or ships
	  Android's WebView (the prebuilt webview projects are commented out in
	  lineage.xml too), so the cleanest fix is not to sync the project at all.
	-->
	<remove-project name="LineageOS/android_external_chromium-webview_patches" />
</manifest>
