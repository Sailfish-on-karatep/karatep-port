#!/sbin/sh
OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo -n -e "ui_print $1\n" > /proc/self/fd/$OUTFD
  echo -n -e "ui_print\n" > /proc/self/fd/$OUTFD
}

ui_print "========================================"
ui_print "Sailfish OS Installer (Shell Fallback v2)"
ui_print "========================================"

ui_print "Mounting data..."
mount -t ext4 /dev/block/bootdevice/by-name/userdata /data
mount /data

ui_print "Cleaning old installation..."
rm -rf /data/.stowaways/sailfishos
mkdir -p /data/.stowaways/sailfishos
mkdir -p /data/sfos_installer

ui_print "Unzipping package to data (bypassing RAM limits)..."
unzip -o "$ZIPFILE" hybris-boot.img sailfishos-karatep-release-5.1.0.11.tar.bz2 -d /data/sfos_installer

ui_print "Extracting rootfs..."
tar --numeric-owner -xvjf /data/sfos_installer/sailfishos-karatep-release-5.1.0.11.tar.bz2 -C /data/.stowaways/sailfishos
if [ $? -ne 0 ]; then
  ui_print "Failed to extract rootfs! Error extracting tar."
  exit 1
fi

ui_print "Flashing hybris-boot.img ..."
dd if=/data/sfos_installer/hybris-boot.img of=/dev/block/bootdevice/by-name/boot
if [ $? -ne 0 ]; then
  ui_print "Failed to flash boot!"
  exit 1
fi

ui_print "Cleaning up..."
rm -rf /data/sfos_installer
umount /data

ui_print "Flashing completed successfully!"
exit 0
